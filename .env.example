# ==============================================================================
# AI News Monitoring & Daily Digest System Configuration
# ==============================================================================

# 1. Google Gemini API Key (100% Free)
# Get your free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 2. Telegram Bot Configuration
# Create a bot using @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Your personal Telegram Chat ID (Get it by messaging @userinfobot on Telegram)
TELEGRAM_CHAT_ID=

# 3. Email Digest Configuration (100% Free Gmail SMTP / App Password)
# Set to true when you want to enable automated email newsletters
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Your Gmail address (e.g., yourname@gmail.com)
EMAIL_USERNAME=

# Google App Password (16 characters from: https://myaccount.google.com/apppasswords)
EMAIL_PASSWORD=

# Where to send the email (leave empty to send to yourself)
EMAIL_RECIPIENT=

# 4. Automation & Schedule Settings
# Continuous news crawl interval in minutes (default: 30)
FETCH_INTERVAL_MINUTES=30
TIMEZONE=Asia/Dhaka

# 5. Server Configuration
HOST=127.0.0.1
PORT=8000
